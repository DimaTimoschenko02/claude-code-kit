#!/usr/bin/env bash
# Adds a mod folder to CLAUDE_CODE_PLUGIN_DIRS in ~/.claude/settings.json and, given JSON, sets its options.
# Backs the file up first and writes only a result that parses. Sessions see the mod from their next start.
# On Windows (Git Bash) the list is ';'-separated and the folders are kept as C:/... paths; elsewhere ':' and POSIX paths.
#
# usage: mod-wire <mod dir> ['{"option": value}']
set -euo pipefail

case "$(uname -s)" in MINGW* | MSYS* | CYGWIN*) is_windows=1 ;; *) is_windows=0 ;; esac
[[ ${OS:-} == Windows_NT ]] && is_windows=1

# A real interpreter: python3/python on PATH minus the WindowsApps Store stubs (they exit 9009 instead of running),
# else the `py -3` launcher. Each candidate must actually run, so a stub that slipped through is not picked.
find_python() {
  local name candidate
  for name in python3 python; do
    while IFS= read -r candidate; do
      case "$candidate" in */WindowsApps/*) continue ;; esac
      if "$candidate" -c 'import json' >/dev/null 2>&1; then
        python=("$candidate")
        return 0
      fi
    done < <(type -aP "$name" 2>/dev/null)
  done
  if command -v py >/dev/null 2>&1 && py -3 -c 'import json' >/dev/null 2>&1; then
    python=(py -3)
    return 0
  fi
  return 1
}

# The path as native tools read it: C:/Users/x on Windows, unchanged elsewhere.
native() {
  if ((is_windows)) && command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s' "$1"; fi
}

python=()
find_python || { echo "mod-wire: no working python (python3, python or py -3) on PATH" >&2; exit 1; }

dir=$(cd "${1:?usage: mod-wire <mod dir> [options-json]}" && pwd)
dir=$(native "$dir")
options=${2:-}
settings="$HOME/.claude/settings.json"
backup="$HOME/.claude/state/backups/settings.json.bak-modwire-$(date +%s)"
mkdir -p "$(dirname "$backup")"
cp "$settings" "$backup"

sep=':'
((is_windows)) && sep=';'
export PYTHONUTF8=1

"${python[@]}" - "$(native "$settings")" "$dir" "$options" "$sep" "$is_windows" <<'EOF'
import json, os, sys
path, mod, options, sep, is_windows = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5] == '1'
sys.stdout.reconfigure(encoding='utf-8', newline='\n')

def same(a, b):
    # one folder spelled two ways (C:\x, c:/x/) is not added twice; Windows paths ignore case
    norm = lambda p: p.replace('\\', '/').rstrip('/')
    return norm(a).lower() == norm(b).lower() if is_windows else norm(a) == norm(b)

with open(path, encoding='utf-8') as f:
    s = json.load(f)
env = s.setdefault('env', {})
dirs = [d for d in env.get('CLAUDE_CODE_PLUGIN_DIRS', '').split(sep) if d]
if not any(same(d, mod) for d in dirs):
    dirs.append(mod)
env['CLAUDE_CODE_PLUGIN_DIRS'] = sep.join(dirs)
if options:
    with open(os.path.join(mod, '.claude-plugin', 'plugin.json'), encoding='utf-8') as f:
        name = json.load(f)['name']
    s.setdefault('pluginConfigs', {}).setdefault(name, {})['options'] = json.loads(options)
text = json.dumps(s, indent=2, ensure_ascii=False) + '\n'
json.loads(text)
with open(path, 'w', encoding='utf-8', newline='\n') as f:
    f.write(text)
print('\n'.join(dirs))
EOF
echo "backup: $backup"
