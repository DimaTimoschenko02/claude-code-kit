#!/usr/bin/env bash
# Stop hook of the mod-builder agent (its frontmatter `hooks: Stop`, which runs as SubagentStop): the agent may not
# finish while mod-check has failures in the memory inbox it has not turned into lessons. The failure is recorded
# by code; this makes the lesson happen too, instead of hoping the agent remembers.
set -uo pipefail

inbox=${MOD_BUILDER_INBOX:-$HOME/.claude/agent-memory/mod-builder/inbox.md}
payload=$(cat 2>/dev/null || true)

[[ -s $inbox ]] || exit 0
# Second refusal in a row: let it stop. The inbox stays, and the next run of the agent meets it again.
[[ $(printf '%s' "$payload" | jq -r '.stop_hook_active // false' 2>/dev/null) == true ]] && exit 0

count=$(grep -c '^- ' "$inbox")
cat >&2 <<EOF
$inbox holds $count failed check(s) from mod-check. Before you finish: for each, add a lesson to MEMORY.md next to it
(the cause in one sentence and what to do instead, under its topic) or, if a lesson there already covers it, sharpen
that one; then empty inbox.md. A failure whose cause was a typo with nothing to learn is dropped, not recorded.
EOF
exit 2
