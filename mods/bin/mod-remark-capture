#!/usr/bin/env bash
# UserPromptSubmit hook (global settings): an owner message that names a mod — its folder name, its /command, a word
# from its plugin.json `keywords` (how the owner calls it: «панель», «прогрев»), or the word «мод» — is appended
# verbatim to the mod-builder agent's memory inbox. The agent learns from failed checks inside its own run; the owner's «не видно», «обрезано», «убери» arrive after it has finished, in another session,
# and were lost. The agent's stop hook makes it turn each inbox line into a lesson or drop it.
# Never blocks, never prints: exit 0 on every path.
set -uo pipefail

inbox=${MOD_BUILDER_INBOX:-$HOME/.claude/agent-memory/mod-builder/inbox.md}
prompt=$(jq -r '.prompt // empty' 2>/dev/null) || exit 0
[[ -n $prompt ]] || exit 0
# A message that starts with a slash command runs the command; it is not a remark about it.
[[ $prompt == /* ]] && exit 0

dirs=${CLAUDE_CODE_PLUGIN_DIRS:-$(jq -r '.env.CLAUDE_CODE_PLUGIN_DIRS // empty' "$HOME/.claude/settings.json" 2>/dev/null)}
names=()
IFS=':' read -ra list <<<"$dirs"
for d in ${list[@]+"${list[@]}"}; do
  [[ -d $d ]] || continue
  names+=("$(basename "$d")")
  while IFS= read -r k; do [[ -n $k ]] && names+=("$k"); done < <(
    jq -r '.keywords[]? // empty' "$d/.claude-plugin/plugin.json" 2>/dev/null
  )
  # a mod's slash command: `export const COMMAND = 'warm'` or `name: 'warm'` in its register call
  while IFS= read -r c; do names+=("/$c"); done < <(
    grep -hoE "COMMAND = '[a-z][a-z0-9-]*'" "$d"/hooks/*.ts* 2>/dev/null | sed -E "s/.*'(.*)'/\1/"
  )
done

# perl, not tr: tr without a UTF-8 locale leaves Cyrillic capitals as they are
lower=$(printf '%s' "$prompt" | perl -CSA -pe '$_ = lc')
hit=''
for n in ${names[@]+"${names[@]}"}; do
  if [[ $n == /* ]]; then
    printf '%s' "$lower" | grep -qE "(^|[^a-z0-9/])${n}([^a-z0-9-]|$)" && { hit=$n; break; }
  else
    [[ $lower == *"$(printf '%s' "$n" | perl -CSA -pe '$_ = lc')"* ]] && { hit=$n; break; }
  fi
done
# «мод», «моды», «мода», «модом», … but not «модуль» / «модель»
[[ -z $hit ]] && printf '%s' "$lower" |
  perl -CSA -Mutf8 -0777 -ne 'exit(/(?<!\p{L})мод(?:а|у|ом|е|ы|ов|ам|ами|ах)?(?!\p{L})/ ? 0 : 1)' && hit='мод'
[[ -n $hit ]] || exit 0

mkdir -p "$(dirname "$inbox")"
text=$(printf '%s' "$prompt" | tr '\n' ' ' | cut -c1-600)
printf -- '- %s · owner remark (%s) · %s\n' "$(date '+%F %H:%M')" "$hit" "$text" >>"$inbox"
exit 0
