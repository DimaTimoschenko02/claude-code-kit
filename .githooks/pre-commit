#!/usr/bin/env bash
# Blocks personal / workspace-specific content from entering this public repo.
#
# Why: skills are tuned in the field, inside real workspaces, so private paths, project names and quotes
# accrete in them. Now the skills are symlinked here and every field edit lands in this working tree — so the
# check has to happen at commit time. What counts as personal — .githooks/private-check.sh.
#
# Scope: only ADDED lines in the staged diff. Pre-existing matches are legacy and must not block unrelated
# work; touching such a line does surface it, on purpose.
set -uo pipefail

# .githooks/ is excluded: the checker necessarily contains the patterns it looks for.
# -E on both greps: in BSD grep's BRE, '\+' is a repetition operator, so '^\+\+\+' is an invalid regex.
added="$(git diff --cached -U0 --diff-filter=ACM -- . ':(exclude).githooks/' \
  | grep -E '^\+' | grep -vE '^\+\+\+' || true)"
[ -z "$added" ] && exit 0

hits="$(printf '%s\n' "$added" | bash "$(dirname "$0")/private-check.sh")" && exit 0

echo "🚧 pre-commit: personal content in staged lines — this repo is public." >&2
printf '%s\n' "$hits" >&2
echo "   Move workspace specifics into that workspace (config, .claude/rules/, its own tests), then re-stage." >&2
echo "   Deliberate exception: git commit --no-verify" >&2
exit 1
